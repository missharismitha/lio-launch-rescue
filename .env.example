LIO_DATA_DIR=data/soony-data
LIO_STATE_DIR=.local
LIO_PORTAL_TOKEN=
LIO_POLL_SECONDS=60
# Optional: read-only model investigation. Source excerpts are sent on explicit UI action.
OPENAI_API_KEY=
