LIO_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Set only verified hackathon supplier inbox addresses, never personal guesses.
LIO_GAME_CARD_RECIPIENT=
LIO_ART_BOOK_RECIPIENT=
